{
  "name": "@woowacourse/javascript-calculator",
  "version": "1.0.0",
  "description": "우아한테크코스 웹 프론트엔드 레벨1 계산기 미션",
  "author": "Erica Gong",
  "scripts": {
    "test": "jest --coverage",
    "eslint": "eslint --cache ./src __tests__",
    "format": "prettier --cache --write .",
    "commitlint": "commitlint --edit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@babel/core": "^7.20.12",
    "@babel/preset-env": "^7.20.2",
    "@commitlint/cli": "^19.4.0",
    "@commitlint/config-conventional": "^19.2.2",
    "babel-jest": "^29.3.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^28.8.2",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.5",
    "jest": "^29.3.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.3.3"
  },
  "jest": {
    "transform": {
      "\\.[jt]sx?$": "babel-jest"
    }
  },
  "babel": {
    "presets": [
      "@babel/preset-env"
    ]
  },
  "lint-staged": {
    "*.js": [
      "prettier --write",
      "eslint --cache --fix"
    ]
  }
}
